# Minimal test to reproduce duplicate MI notification bug in HIP programs.
#
# The bug: When a regular breakpoint is hit in MI mode after HIP runtime
# initialization (warm_up kernel), the entire stop notification sequence
# appears TWICE:
#   =breakpoint-modified,bkpt={number="N",...}
#   ~"\n"
#   ~"Breakpoint N, test_function ()..."
#   *stopped,reason="breakpoint-hit",...
#
# This is a minimal reproducer stripped from solib-event.exp.
# No solib-event code, just HIP init + breakpoint.

load_lib rocm.exp
load_lib mi-support.exp

require allow_hip_tests

standard_testfile .cpp

if {[build_executable "failed to prepare" $testfile $srcfile {debug hip}] == -1} {
    return
}

# Test MI output for duplicate notifications.
global MIFLAGS
global mi_gdb_prompt

set MIFLAGS "-i=mi2"

with_rocm_gpu_lock {
    if {[mi_clean_restart $::testfile]} {
	return
    }

    if {![mi_runto_main]} {
	return
    }

    # Match solib-event.exp sequence EXACTLY:
    # 1. Run to main
    # 2. Continue to marker (warm_up runs during this continue)
    # 3. Set stop-on-solib-events=1
    # 4. Set breakpoint at test function
    # 5. Continue to breakpoint <- duplicate happens here

    mi_create_breakpoint [gdb_get_line_number "Enable SOLIB events here"] \
	"insert breakpoint at enable marker"

    mi_send_resuming_command "exec-continue" "continue to enable marker"
    # The warm_up<<<>>>() kernel loads code objects here.
    # Consume async notifications before expecting the breakpoint stop.
    gdb_expect {
	-re "=library-loaded\[^\r\n\]*\r\n" {
	    exp_continue
	}
	-re "=thread-created\[^\r\n\]*\r\n" {
	    exp_continue
	}
	-re "\\*running\[^\r\n\]*\r\n" {
	    exp_continue
	}
	-re "~\[^\r\n\]*\r\n" {
	    exp_continue
	}
	-re "\\*stopped,reason=\"breakpoint-hit\"\[^\r\n\]*\r\n$mi_gdb_prompt" {
	    pass "stop at enable marker"
	}
	timeout {
	    fail "stop at enable marker (timeout)"
	}
    }

    # Now set stop-on-solib-events=1 (warm_up has already run).
    mi_gdb_test "-gdb-set stop-on-solib-events 1" "\\^done" \
	"enable stop-on-solib-events"

    # Set breakpoint at test_function.
    mi_create_breakpoint [gdb_get_line_number "BREAKPOINT_HERE"] \
	"insert breakpoint at test_function"

    mi_send_resuming_command "exec-continue" "continue to test_function"

    # This is where the duplicate occurs in solib-event.exp.
    # Expected: Single sequence of =breakpoint-modified, console, *stopped
    # Bug: Entire sequence appears TWICE
    # Confirmed in solib-event.exp: breakpoint #3 notifications appear 2x

    set breakpoint_modified_count 0
    set stopped_count 0

    gdb_expect {
	-re "=breakpoint-modified,bkpt=\{number=\"\[0-9\]+\"" {
	    incr breakpoint_modified_count
	    exp_continue
	}
	-re "~\"\\\\n\"\r\n" {
	    exp_continue
	}
	-re "~\".*Breakpoint.*test_function.*\"\r\n" {
	    exp_continue
	}
	-re "~\".*printf.*\"\r\n" {
	    exp_continue
	}
	-re "\\*stopped,reason=\"breakpoint-hit\".*\r\n" {
	    incr stopped_count
	    exp_continue
	}
	-re "$mi_gdb_prompt$" {
	    # Got prompt - check for duplicates.
	    if {$breakpoint_modified_count > 1} {
		fail "duplicate =breakpoint-modified detected (count=$breakpoint_modified_count)"
	    } elseif {$stopped_count > 1} {
		fail "duplicate *stopped detected (count=$stopped_count)"
	    } else {
		pass "no duplicate MI notifications"
	    }
	}
	timeout {
	    fail "timeout waiting for breakpoint stop"
	}
    }

    mi_gdb_exit
}
